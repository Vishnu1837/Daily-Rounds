# ---------------------------------------------------------------------------
# Daily Rounds — environment variables
# ---------------------------------------------------------------------------
# Copy to .env.local for development, or set these in your hosting provider.

# Postgres connection string. When ABSENT, the app uses an embedded PGlite database
# stored in .data/ so local development works with zero setup.
# For Supabase, use the "Connection pooling" (transaction mode, port 6543) URI.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Optional: maximum pooled connections (default 10).
# DATABASE_POOL_MAX=10

# Optional: where the embedded dev database stores its files.
# PGLITE_DATA_DIR=".data/daily-rounds"

# Required before `npm run db:reset` will touch a hosted database.
# ALLOW_DB_RESET=false

# --- Seed configuration (development only) ---------------------------------
# SEED_TIMEZONE="Asia/Kolkata"
# SEED_ADMIN_EMAIL="admin@dailyrounds.app"
# SEED_ADMIN_PASSWORD="roundsadmin123"
# SEED_STUDENT_PASSWORD="roundsdemo123"
# SEED_MEET_URL="https://meet.google.com/your-room"

# --- Destructive-script guard ----------------------------------------------
# `db:seed` and `db:reset` both TRUNCATE every table. They refuse to run against a
# remote database unless this is set. Never set it in a hosting provider.
# ALLOW_REMOTE_DESTRUCTIVE=1

# --- Public site -----------------------------------------------------------
# These reach the browser. Never put a secret here.
# All are optional; each has a safe fallback, and any route without a value is
# hidden rather than rendered as a dead link.

# Founder Instagram handle, without the "@".
# NEXT_PUBLIC_INSTAGRAM_HANDLE="mohd.imrxn"

# WhatsApp enquiry number: digits only, country code included, no "+".
# Leave unset until confirmed — the landing page hides the WhatsApp CTA without it.
# NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# Founder photograph. Falls back to a monogram when unset.
# NEXT_PUBLIC_FOUNDER_PHOTO_URL="https://.../imran.jpg"

# Cohort + CTA labels, so a new batch needs no code change.
# NEXT_PUBLIC_COHORT_LABEL="Cohort 02"
# NEXT_PUBLIC_NEXT_COHORT_LABEL="Cohort 03"
# NEXT_PUBLIC_WAITLIST_CTA="Join the waitlist"
# NEXT_PUBLIC_ENTER_COHORT_CTA="Enter cohort"

# --- Transactional mail ----------------------------------------------------
# Password reset links are sent from here. Without both values the reset flow still
# works in development — the link is shown on the page instead — but in production a
# student who forgets their password receives nothing, so set both before launch.

# Provisioned by the Resend integration on Vercel; `vercel env pull` brings it down.
# RESEND_API_KEY="re_..."

# The From address. Resend only sends from a domain verified in its dashboard, so this
# has no default — a guessed address would be rejected at the provider and look like a
# silent failure here.
# MAIL_FROM="Daily Rounds 360 <no-reply@yourdomain.com>"

# The site's own origin, used to build absolute links for mail. Falls back to Vercel's
# production URL, then to the request host.
# NEXT_PUBLIC_APP_URL="https://dailyrounds360.com"
