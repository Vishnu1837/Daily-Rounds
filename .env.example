# ---------------------------------------------------------------------------
# Daily Rounds — environment variables
# ---------------------------------------------------------------------------
# Copy to .env.local for development, or set these in your hosting provider.

# Postgres connection string. When ABSENT, the app uses an embedded PGlite database
# stored in .data/ so local development works with zero setup.
# For Supabase, use the "Connection pooling" (transaction mode, port 6543) URI.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Optional: maximum pooled connections (default 10).
# DATABASE_POOL_MAX=10

# Optional: where the embedded dev database stores its files.
# PGLITE_DATA_DIR=".data/daily-rounds"

# Required before `npm run db:reset` will touch a hosted database.
# ALLOW_DB_RESET=false

# --- Seed configuration (development only) ---------------------------------
# SEED_TIMEZONE="Asia/Kolkata"
# SEED_ADMIN_EMAIL="admin@dailyrounds.app"
# SEED_ADMIN_PASSWORD="roundsadmin123"
# SEED_STUDENT_PASSWORD="roundsdemo123"
# SEED_MEET_URL="https://meet.google.com/your-room"
